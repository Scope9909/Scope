{
    "data_config": {
        "dataset_name": "PEMS04",
        "input_length": 12,
        "predict_length": 12,
        "scaler_type": "zscore",
        "slice_size_per_day": 288,
        "in_dim": 1,
        "pre_dim": 1,
        "train_ratio": 0.6,
        "test_ratio": 0.2
    },
    "model_config": {
        "modelid": "TLAST_improved",
        "hid_dim": 64,
        "d_out": 1024,
        "n_heads": 1,
        "M": 8,
        "num_layers": 1,
        "tau": 3,
        "query_cross_time": 1,
        "enc_dropout": 0.1,
        "att_dropout": 0.1,
        "emb_dropout": 0.1,
        "te_emb_dropout": 0.1,
        "se_emb_dropout": 0.1,
        "tle_emb_dropout": 0.1,

        "use_ftle": 1,
        "use_mapa": 1,
        "lambda_ortho": 0.01,
        "num_prototypes": 16,
        "tau_list": [3, 5, 7],

        "return_att": 0,
        "norm_flag": "none",
        "att_type": "proxy",
        "activation_data": "relu",
        "activation_enc": "gelu",
        "activation_dec": "gelu",
        "use_graph_conv": 0,
        "graph_conv_type": "adaptive",
        "k_hops": "1,2",

        "predictor_type": "richer"
    },
    "training_config": {
        "device": "cuda:0",
        "batch_size": 32,
        "learning_rate": 0.001,
        "weight_decay": 0.001,
        "epochs": 100,
        "print_every": 50,
        "early_stop": false,
        "early_stop_step": 20,
        "lr_decay": 1,
        "loss_type": "masked_mae_0",
        "huber_delta": 2,
        "eval_mask": 0,
        "lr_scheduler_type": "cosinelr"
    }
}
